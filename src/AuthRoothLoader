import { queryClient } from "./Query";
import { fetchCurrentUser } from "./useAuthStore";

export const rootAuthLoader = async () => {
  try{
    const  user  = await queryClient.query({
     queryKey: ['authUser'],
     queryFn: fetchCurrentUser,
     staleTime: 1000 * 60 * 5,
     retry: false,
    });

  return user;
  } catch (error) {
    
   return null;
  }
}